# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# developers.facebook.com -> your app -> Settings -> Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# @BotFather -> /newbot, then /setdomain for your site's domain
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=86400

# Test mode (DEBUG only): login buttons sign in fake users without real provider keys
SOCIAL_AUTH_MOCK=False

# --- Email codes (sign up / sign in) ---
# Without EMAIL_HOST, emails are only printed to the runserver console.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com,
#        EMAIL_HOST_PASSWORD=<16-char App Password>  (myaccount.google.com/apppasswords)
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 + TLS (default) or 465 + SSL: set EMAIL_USE_SSL=True
EMAIL_PORT=587
EMAIL_USE_SSL=False
# Optional; defaults to "Auth <EMAIL_HOST_USER>"
DEFAULT_FROM_EMAIL=

# Development only (works only with DEBUG=True): every email code is this value and
# no email is sent, so sign up works without SMTP. Remove to send real 6-digit codes.
EMAIL_TEST_CODE=
# Seconds a code stays valid
EMAIL_CODE_TTL=60
