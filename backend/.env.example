# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# developers.facebook.com -> your app -> Settings -> Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# @BotFather -> /newbot, then /setdomain for your site's domain
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE=86400

# Test mode (DEBUG only): login buttons sign in fake users without real provider keys
SOCIAL_AUTH_MOCK=False
